#!/bin/bash
# preinstall for Hangyeol.pkg

CURRENT_USER=$(/usr/bin/stat -f "%Su" /dev/console 2>/dev/null || true)

case "$CURRENT_USER" in
    ""|root|loginwindow)
        CURRENT_USER=""
        ;;
esac

if [ -n "$CURRENT_USER" ]; then
    USER_ID=$(/usr/bin/id -u "$CURRENT_USER" 2>/dev/null || true)
    USER_HOME=$(/usr/bin/dscl . -read "/Users/$CURRENT_USER" NFSHomeDirectory 2>/dev/null \
        | /usr/bin/awk '{ print $2 }')

    if [ -n "$USER_ID" ]; then
        run_as_console_user() {
            /bin/launchctl asuser "$USER_ID" /usr/bin/sudo -H -u "$CURRENT_USER" "$@"
        }

        INSTALLED_VERSION=""
        HANGYEOL_WAS_INSTALLED=false
        for installed_info_plist in \
            "/Library/Input Methods/Hangyeol.app/Contents/Info.plist" \
            "/Library/Input Methods/PriType.app/Contents/Info.plist" \
            "/Library/Input Methods/PriTypeV2.app/Contents/Info.plist"; do
            if [ -f "$installed_info_plist" ]; then
                HANGYEOL_WAS_INSTALLED=true
                INSTALLED_VERSION=$(/usr/libexec/PlistBuddy \
                    -c "Print :CFBundleShortVersionString" \
                    "$installed_info_plist" 2>/dev/null || true)
                break
            fi
        done

        # PackageKit can fall back to ABC while it replaces the selected input
        # method. Capture the user's real pre-update selection so postinstall
        # can restore it without hijacking intentional ABC users.
        if run_as_console_user /usr/bin/defaults read \
            com.apple.HIToolbox AppleSelectedInputSources 2>/dev/null \
            | /usr/bin/grep -q \
                -e "com.thlim.inputmethod.Hangyeol" \
                -e "com.thlim.hangyeol.inputmethod" \
                -e "com.meapri.hangyeol.inputmethod" \
                -e "com.pritype.inputmethod.v2"; then
            HANGYEOL_WAS_SELECTED=true
        else
            HANGYEOL_WAS_SELECTED=false
        fi

        # 2.8.24 and 2.8.25 could leave an enabled Hangyeol registration behind
        # while falling back to ABC. Recover those known broken installations
        # once; later updates continue to preserve an intentional ABC choice.
        case "$INSTALLED_VERSION" in
            2.8.24|2.8.25)
                HANGYEOL_WAS_SELECTED=true
                ;;
        esac

        run_as_console_user /usr/bin/defaults write com.thlim.inputmethod.Hangyeol \
            HangyeolSelectedBeforeInstall -bool "$HANGYEOL_WAS_SELECTED" || true
        run_as_console_user /usr/bin/defaults write com.thlim.inputmethod.Hangyeol \
            HangyeolInstalledBeforeInstall -bool "$HANGYEOL_WAS_INSTALLED" || true

        # Keep the current Hangyeol IMK server alive during an update. Existing
        # host applications own connections to that process; terminating it
        # before a replacement session exists leaves Chrome and Electron apps
        # attached to a stale controller until logout or restart.
        /usr/bin/pkill -x -u "$USER_ID" PriType 2>/dev/null || true
        /usr/bin/pkill -x -u "$USER_ID" PriTypeV2 2>/dev/null || true

        # Retired bundle identities cannot reuse their Accessibility grants.
        # Remove only those old product grants; the current identity remains a
        # user-controlled TCC decision.
        run_as_console_user /usr/bin/tccutil reset Accessibility \
            com.thlim.hangyeol.inputmethod >/dev/null 2>&1 || true
        run_as_console_user /usr/bin/tccutil reset Accessibility \
            com.meapri.hangyeol.inputmethod >/dev/null 2>&1 || true
        run_as_console_user /usr/bin/tccutil reset Accessibility \
            com.pritype.inputmethod.v2 >/dev/null 2>&1 || true
    fi

    case "$USER_HOME" in
        /Users/*)
            /bin/rm -rf "$USER_HOME/Library/Input Methods/Hangyeol.app"
            /bin/rm -rf "$USER_HOME/Library/Input Methods/PriType.app"
            /bin/rm -rf "$USER_HOME/Library/Input Methods/PriTypeV2.app"
            ;;
    esac
fi

# PackageKit performs an atomic update of the current Hangyeol.app bundle. Do
# not delete it here: removing it creates a registration gap in the user's TIS
# domain before the replacement bundle is installed. Retired 2.x bundles and
# receipts are removed explicitly so they cannot appear as duplicate products.
/bin/rm -rf "/Library/Input Methods/PriType.app"
/bin/rm -rf "/Library/Input Methods/PriTypeV2.app"
/bin/rm -rf "/Library/Input Methods/Hangyeol.localized"
/usr/sbin/pkgutil --forget com.meapri.hangyeol >/dev/null 2>&1 || true
/usr/sbin/pkgutil --forget com.meapri.PriTypeV2 >/dev/null 2>&1 || true
/usr/sbin/pkgutil --forget com.pritype.inputmethod.v2.pkg >/dev/null 2>&1 || true

exit 0
