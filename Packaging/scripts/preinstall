#!/bin/bash
# preinstall for Hangyeol.pkg

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
PACKAGED_HELPER="$SCRIPT_DIR/HangyeolInstallerHelper"
STAGING_DIR=""
STAGED_HELPER=""

cleanup() {
    if [ -n "$STAGING_DIR" ] && [ -d "$STAGING_DIR" ]; then
        /bin/rm -rf "$STAGING_DIR"
    fi
}
trap cleanup EXIT

CURRENT_USER=$(/usr/bin/stat -f "%Su" /dev/console 2>/dev/null || true)

case "$CURRENT_USER" in
    ""|root|loginwindow)
        CURRENT_USER=""
        ;;
esac

if [ -n "$CURRENT_USER" ]; then
    USER_ID=$(/usr/bin/id -u "$CURRENT_USER" 2>/dev/null || true)
    USER_HOME=$(/usr/bin/dscl . -read "/Users/$CURRENT_USER" NFSHomeDirectory \
        2>/dev/null | /usr/bin/awk '{ print $2 }')

    if [ -n "$USER_ID" ]; then
        run_as_console_user() {
            /bin/launchctl asuser "$USER_ID" \
                /usr/bin/sudo -H -u "$CURRENT_USER" "$@"
        }

        if [ ! -x "$PACKAGED_HELPER" ] \
            || ! /usr/bin/codesign --verify --strict "$PACKAGED_HELPER"; then
            echo "Hangyeol preinstall helper is missing or has an invalid signature." >&2
            exit 1
        fi

        # PackageKit's private Scripts directory is not guaranteed to be
        # traversable by the console user. Run the signed helper from a narrow,
        # disposable directory whose contents are verified again after copying.
        STAGING_DIR=$(/usr/bin/mktemp -d "/private/tmp/hangyeol-preinstall.XXXXXX")
        /bin/chmod 755 "$STAGING_DIR"
        STAGED_HELPER="$STAGING_DIR/HangyeolInstallerHelper"
        /usr/bin/install -m 755 "$PACKAGED_HELPER" "$STAGED_HELPER"
        /usr/bin/codesign --verify --strict "$STAGED_HELPER"

        INSTALLED_VERSION=""
        INSTALLED_BUNDLE_IDENTIFIER=""
        INSTALLED_CONNECTION_NAME=""
        INSTALLED_INPUT_MODE_SCHEMA=""
        HANGYEOL_WAS_INSTALLED=false
        for installed_info_plist in \
            "/Library/Input Methods/Hangyeol.app/Contents/Info.plist" \
            "/Library/Input Methods/PriType.app/Contents/Info.plist" \
            "/Library/Input Methods/PriTypeV2.app/Contents/Info.plist"; do
            if [ -f "$installed_info_plist" ]; then
                HANGYEOL_WAS_INSTALLED=true
                INSTALLED_VERSION=$(/usr/libexec/PlistBuddy \
                    -c "Print :CFBundleShortVersionString" \
                    "$installed_info_plist" 2>/dev/null || true)
                INSTALLED_BUNDLE_IDENTIFIER=$(/usr/libexec/PlistBuddy \
                    -c "Print :CFBundleIdentifier" \
                    "$installed_info_plist" 2>/dev/null || true)
                INSTALLED_CONNECTION_NAME=$(/usr/libexec/PlistBuddy \
                    -c "Print :InputMethodConnectionName" \
                    "$installed_info_plist" 2>/dev/null || true)
                INSTALLED_INPUT_MODE_SCHEMA=$(/usr/bin/plutil \
                    -extract ComponentInputModeDict json -o - \
                    "$installed_info_plist" 2>/dev/null || true)
                break
            fi
        done

        # Move away from every current or retired Hangyeol identity before its
        # executable is replaced. Failure is fatal: replacing the active IMK
        # server is the exact state that leaves the current login session stale.
        if ! PREPARE_OUTPUT=$(run_as_console_user \
            "$STAGED_HELPER" --prepare-update); then
            echo "Hangyeol could not select a safe fallback input source." >&2
            exit 1
        fi
        SELECTED_BEFORE=$(/usr/bin/printf '%s\n' "$PREPARE_OUTPUT" \
            | /usr/bin/awk -F= '$1 == "selected-before" { print $2 }')
        FALLBACK_SOURCE_ID=$(/usr/bin/printf '%s\n' "$PREPARE_OUTPUT" \
            | /usr/bin/awk -F= '$1 == "fallback-source-id" { print $2 }')
        FALLBACK_WAS_ENABLED=$(/usr/bin/printf '%s\n' "$PREPARE_OUTPUT" \
            | /usr/bin/awk -F= '$1 == "fallback-was-enabled" { print $2 }')
        case "$SELECTED_BEFORE" in
            true)
                HANGYEOL_WAS_SELECTED=true
                ;;
            false)
                HANGYEOL_WAS_SELECTED=false
                ;;
            *)
                echo "Hangyeol preinstall helper returned an invalid result." >&2
                exit 1
                ;;
        esac
        case "$FALLBACK_WAS_ENABLED" in
            true|false)
                ;;
            *)
                echo "Hangyeol preinstall helper returned invalid fallback state." >&2
                exit 1
                ;;
        esac
        if [ -z "$FALLBACK_SOURCE_ID" ]; then
            echo "Hangyeol preinstall helper omitted its fallback identity." >&2
            exit 1
        fi

        # Recover known 2.x fallback failures once. Newer updates preserve an
        # intentional non-Hangyeol selection exactly as reported by TIS.
        case "$INSTALLED_VERSION" in
            2.8.24|2.8.25)
                HANGYEOL_WAS_SELECTED=true
                ;;
        esac

        run_as_console_user /usr/bin/defaults write \
            com.thlim.inputmethod.Hangyeol \
            HangyeolSelectedBeforeInstall -bool "$HANGYEOL_WAS_SELECTED"
        run_as_console_user /usr/bin/defaults write \
            com.thlim.inputmethod.Hangyeol \
            HangyeolInstalledBeforeInstall -bool "$HANGYEOL_WAS_INSTALLED"
        run_as_console_user /usr/bin/defaults write \
            com.thlim.inputmethod.Hangyeol \
            HangyeolInstalledBundleIdentifier -string \
            "$INSTALLED_BUNDLE_IDENTIFIER"
        run_as_console_user /usr/bin/defaults write \
            com.thlim.inputmethod.Hangyeol \
            HangyeolInstalledConnectionName -string \
            "$INSTALLED_CONNECTION_NAME"
        run_as_console_user /usr/bin/defaults write \
            com.thlim.inputmethod.Hangyeol \
            HangyeolInstalledInputModeSchema -string \
            "$INSTALLED_INPUT_MODE_SCHEMA"
        run_as_console_user /usr/bin/defaults write \
            com.thlim.inputmethod.Hangyeol \
            HangyeolFallbackInputSourceID -string "$FALLBACK_SOURCE_ID"
        run_as_console_user /usr/bin/defaults write \
            com.thlim.inputmethod.Hangyeol \
            HangyeolFallbackWasEnabled -bool "$FALLBACK_WAS_ENABLED"

        # Terminate only input-method processes owned by this product. The
        # helper polls the exact condition, so PackageKit never relies on a
        # fixed delay and never restarts macOS text-input services.
        for process_name in Hangyeol PriType PriTypeV2; do
            /usr/bin/pkill -TERM -x -u "$USER_ID" "$process_name" \
                2>/dev/null || true
        done
        if ! run_as_console_user "$STAGED_HELPER" \
            --wait-for-process-exit 3 Hangyeol PriType PriTypeV2; then
            for process_name in Hangyeol PriType PriTypeV2; do
                /usr/bin/pkill -KILL -x -u "$USER_ID" "$process_name" \
                    2>/dev/null || true
            done
            if ! run_as_console_user "$STAGED_HELPER" \
                --wait-for-process-exit 2 Hangyeol PriType PriTypeV2; then
                echo "Hangyeol input-method process did not terminate." >&2
                exit 1
            fi
        fi

        # Retired identities cannot reuse their Accessibility grants. The
        # current identity remains a user-controlled TCC decision.
        run_as_console_user /usr/bin/tccutil reset Accessibility \
            com.thlim.hangyeol.inputmethod >/dev/null 2>&1 || true
        run_as_console_user /usr/bin/tccutil reset Accessibility \
            com.meapri.hangyeol.inputmethod >/dev/null 2>&1 || true
        run_as_console_user /usr/bin/tccutil reset Accessibility \
            com.pritype.inputmethod.v2 >/dev/null 2>&1 || true
    fi

    case "$USER_HOME" in
        /Users/*)
            /bin/rm -rf "$USER_HOME/Library/Input Methods/Hangyeol.app"
            /bin/rm -rf "$USER_HOME/Library/Input Methods/PriType.app"
            /bin/rm -rf "$USER_HOME/Library/Input Methods/PriTypeV2.app"
            ;;
    esac
fi

# Keep the canonical bundle in place for PackageKit's replacement. Only retired
# names and receipts are removed, so no unrelated input source is touched.
/bin/rm -rf "/Library/Input Methods/PriType.app"
/bin/rm -rf "/Library/Input Methods/PriTypeV2.app"
/bin/rm -rf "/Library/Input Methods/Hangyeol.localized"
/usr/sbin/pkgutil --forget com.meapri.hangyeol >/dev/null 2>&1 || true
/usr/sbin/pkgutil --forget com.meapri.PriTypeV2 >/dev/null 2>&1 || true
/usr/sbin/pkgutil --forget com.pritype.inputmethod.v2.pkg >/dev/null 2>&1 || true

exit 0
