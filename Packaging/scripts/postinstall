#!/bin/bash
# postinstall for Hangyeol.pkg

set -u
set -o pipefail

APP_PATH="/Library/Input Methods/Hangyeol.app"
INFO_PLIST="$APP_PATH/Contents/Info.plist"
EXECUTABLE="$APP_PATH/Contents/MacOS/Hangyeol"
EXPECTED_BUNDLE_IDENTIFIER="com.thlim.inputmethod.Hangyeol"
ACTIVATION_LABEL="com.thlim.hangyeol.activation-repair"
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
PACKAGED_HELPER="$SCRIPT_DIR/HangyeolInstallerHelper"
STAGING_DIR=""
STAGED_HELPER=""

cleanup() {
    if [ -n "$STAGING_DIR" ] && [ -d "$STAGING_DIR" ]; then
        /bin/rm -rf "$STAGING_DIR"
    fi
}
trap cleanup EXIT

# shellcheck source=postinstall_classification.sh
. "$SCRIPT_DIR/postinstall_classification.sh"

if [ ! -x "$EXECUTABLE" ] || [ ! -f "$INFO_PLIST" ]; then
    echo "Installed Hangyeol bundle is incomplete." >&2
    exit 1
fi

CURRENT_BUNDLE_IDENTIFIER=$(/usr/libexec/PlistBuddy \
    -c "Print :CFBundleIdentifier" "$INFO_PLIST" 2>/dev/null || true)
if [ "$CURRENT_BUNDLE_IDENTIFIER" != "$EXPECTED_BUNDLE_IDENTIFIER" ] \
    || ! /usr/bin/codesign --verify --strict "$APP_PATH"; then
    echo "Installed Hangyeol bundle identity or signature is invalid." >&2
    exit 1
fi

CURRENT_USER=$(/usr/bin/stat -f "%Su" /dev/console 2>/dev/null || true)
case "$CURRENT_USER" in
    ""|root|loginwindow)
        # TIS is session-scoped. With no GUI owner there is nothing safe to
        # activate now; macOS discovers the signed bundle at the next login.
        exit 0
        ;;
esac

USER_ID=$(/usr/bin/id -u "$CURRENT_USER" 2>/dev/null || true)
USER_HOME=$(/usr/bin/dscl . -read "/Users/$CURRENT_USER" NFSHomeDirectory \
    2>/dev/null | /usr/bin/awk '{ print $2 }')
case "$USER_HOME" in
    /Users/*)
        ;;
    *)
        echo "Hangyeol could not resolve the console user's home directory." >&2
        exit 0
        ;;
esac
if [ -z "$USER_ID" ]; then
    exit 0
fi

run_as_console_user() {
    /bin/launchctl asuser "$USER_ID" \
        /usr/bin/sudo -H -u "$CURRENT_USER" "$@"
}

if [ ! -x "$PACKAGED_HELPER" ] \
    || ! /usr/bin/codesign --verify --strict "$PACKAGED_HELPER"; then
    echo "Hangyeol postinstall helper is missing or has an invalid signature." >&2
    exit 1
fi
if ! STAGING_DIR=$(/usr/bin/mktemp -d \
    "/private/tmp/hangyeol-postinstall.XXXXXX"); then
    echo "Hangyeol could not create its postinstall helper directory." >&2
    exit 1
fi
/bin/chmod 755 "$STAGING_DIR"
STAGED_HELPER="$STAGING_DIR/HangyeolInstallerHelper"
if ! /usr/bin/install -m 755 "$PACKAGED_HELPER" "$STAGED_HELPER" \
    || ! /usr/bin/codesign --verify --strict "$STAGED_HELPER"; then
    echo "Hangyeol could not stage its signed postinstall helper." >&2
    exit 1
fi

mark_post_install_pending() {
    run_as_console_user /usr/bin/defaults write \
        com.thlim.inputmethod.Hangyeol \
        HangyeolPendingPostInstallSetup -bool true >/dev/null 2>&1 || true
}

open_input_source_settings() {
    run_as_console_user /usr/bin/open \
        "x-apple.systempreferences:com.apple.preference.keyboard?InputSources" \
        >/dev/null 2>&1 || true
}

WAS_INSTALLED=$(run_as_console_user /usr/bin/defaults read \
    com.thlim.inputmethod.Hangyeol \
    HangyeolInstalledBeforeInstall 2>/dev/null || true)
SELECTED_BEFORE=$(run_as_console_user /usr/bin/defaults read \
    com.thlim.inputmethod.Hangyeol \
    HangyeolSelectedBeforeInstall 2>/dev/null || true)
FALLBACK_SOURCE_ID=$(run_as_console_user /usr/bin/defaults read \
    com.thlim.inputmethod.Hangyeol \
    HangyeolFallbackInputSourceID 2>/dev/null || true)
PREVIOUS_BUNDLE_IDENTIFIER=$(run_as_console_user /usr/bin/defaults read \
    com.thlim.inputmethod.Hangyeol \
    HangyeolInstalledBundleIdentifier 2>/dev/null || true)
PREVIOUS_CONNECTION_NAME=$(run_as_console_user /usr/bin/defaults read \
    com.thlim.inputmethod.Hangyeol \
    HangyeolInstalledConnectionName 2>/dev/null || true)
PREVIOUS_INPUT_MODE_SCHEMA=$(run_as_console_user /usr/bin/defaults read \
    com.thlim.inputmethod.Hangyeol \
    HangyeolInstalledInputModeSchema 2>/dev/null || true)
CURRENT_CONNECTION_NAME=$(/usr/libexec/PlistBuddy \
    -c "Print :InputMethodConnectionName" "$INFO_PLIST" 2>/dev/null || true)
CURRENT_INPUT_MODE_SCHEMA=$(/usr/bin/plutil \
    -extract ComponentInputModeDict json -o - "$INFO_PLIST" 2>/dev/null || true)

INSTALLATION_KIND=$(classify_hangyeol_installation \
    "$WAS_INSTALLED" \
    "$PREVIOUS_BUNDLE_IDENTIFIER" \
    "$PREVIOUS_CONNECTION_NAME" \
    "$PREVIOUS_INPUT_MODE_SCHEMA" \
    "$CURRENT_BUNDLE_IDENTIFIER" \
    "$CURRENT_CONNECTION_NAME" \
    "$CURRENT_INPUT_MODE_SCHEMA")

case "$SELECTED_BEFORE" in
    1|true|TRUE|YES)
        SHOULD_SELECT=true
        ;;
    *)
        SHOULD_SELECT=false
        ;;
esac
case "$INSTALLATION_KIND" in
    first-installation)
        SHOULD_SELECT=true
        mark_post_install_pending
        ;;
    registration-change)
        mark_post_install_pending
        ;;
    ordinary-update)
        ;;
    *)
        INSTALLATION_KIND="registration-change"
        mark_post_install_pending
        ;;
esac

if [ "$INSTALLATION_KIND" = "ordinary-update" ]; then
    SESSION_APP=$(run_as_console_user /usr/bin/defaults read \
        com.thlim.inputmethod.Hangyeol \
        HangyeolCurrentSessionAppPath 2>/dev/null || true)
    SESSION_DIR="${SESSION_APP%/Hangyeol.app}"
    case "$SESSION_APP" in
        /private/tmp/hangyeol-session.??????/Hangyeol.app)
            if [ "$SESSION_DIR" != "$SESSION_APP" ] \
                && [ "$(/usr/bin/stat -f '%u' "$SESSION_DIR" 2>/dev/null)" = 0 ] \
                && [ "$(/usr/bin/stat -f '%Lp' "$SESSION_DIR" 2>/dev/null)" = 755 ] \
                && /usr/bin/codesign --verify --strict "$SESSION_APP" \
                && /usr/bin/cmp -s \
                    "$SESSION_APP/Contents/Info.plist" "$INFO_PLIST" \
                && /usr/bin/cmp -s \
                    "$SESSION_APP/Contents/MacOS/Hangyeol" "$EXECUTABLE" \
                && run_as_console_user "$STAGED_HELPER" \
                    --verify-session-runtime \
                    "$SESSION_APP/Contents/MacOS/Hangyeol" \
                    "$SHOULD_SELECT"; then
                # The signed current-session IMK owns the selected source while
                # PackageKit installs the same build at the canonical path.
                # The pending agent below uses that path on the next login.
                SESSION_RUNTIME_READY=true
            fi
            ;;
    esac
fi

# Retain the fallback identity even when it was already enabled: a fresh
# fallback -> Hangyeol transition repairs stale same-session menu ownership.
# The activation worker preserves this source instead of editing HIToolbox.
ACTIVATION_FALLBACK_SOURCE_ID="-"
if [ "$SHOULD_SELECT" = true ] \
    && [ -n "$FALLBACK_SOURCE_ID" ] \
    && [ "$FALLBACK_SOURCE_ID" != "-" ]; then
    ACTIVATION_FALLBACK_SOURCE_ID="$FALLBACK_SOURCE_ID"
fi

# The installed executable writes a generation-tagged marker and a per-user
# LaunchAgent. PackageKit only schedules it; each TIS action and its verifier
# execute later in separate processes owned by the GUI user after the current
# login session has a persistent IMK runtime. The 2.8.18 contract starts that
# runtime with `open`; the LaunchAgent is only a next-login retry.
REPAIR_TIMING=()
if [ "${SESSION_RUNTIME_READY:-false}" = true ]; then
    REPAIR_TIMING=(--next-login-only)
fi
if ! run_as_console_user "$EXECUTABLE" \
    --schedule-input-source-repair \
    "$INSTALLATION_KIND" \
    "$SHOULD_SELECT" \
    "$ACTIVATION_FALLBACK_SOURCE_ID" \
    --after-package-receipt "${REPAIR_TIMING[@]}"; then
    echo "Hangyeol could not schedule input-source activation." >&2
    open_input_source_settings
    exit 0
fi

ACTIVATION_AGENT="$USER_HOME/Library/LaunchAgents/$ACTIVATION_LABEL.plist"
ACTIVATION_MARKER="$USER_HOME/Library/Application Support/Hangyeol/input-source-activation-pending.plist"
if [ ! -f "$ACTIVATION_AGENT" ] || [ ! -f "$ACTIVATION_MARKER" ]; then
    echo "Hangyeol activation agent was not created." >&2
    open_input_source_settings
    exit 0
fi

if [ "${SESSION_RUNTIME_READY:-false}" = true ]; then
    exit 0
fi

# Initial installs, registration changes, and failed session handoffs still
# start the canonical app and repair TIS here. A verified ordinary update
# returns above without interrupting its temporary IMK again.
for process_name in Hangyeol PriType PriTypeV2; do
    /usr/bin/pkill -TERM -x -u "$USER_ID" "$process_name" \
        2>/dev/null || true
done
if ! run_as_console_user "$STAGED_HELPER" \
    --wait-for-process-exit 3 Hangyeol PriType PriTypeV2; then
    for process_name in Hangyeol PriType PriTypeV2; do
        /usr/bin/pkill -KILL -x -u "$USER_ID" "$process_name" \
            2>/dev/null || true
    done
    if ! run_as_console_user "$STAGED_HELPER" \
        --wait-for-process-exit 2 Hangyeol PriType PriTypeV2; then
        echo "Hangyeol could not stop its previous input-method process." >&2
        open_input_source_settings
        exit 0
    fi
fi
if run_as_console_user /usr/bin/open "$APP_PATH"; then
    # Return so PackageKit can publish the new receipt and finish registering
    # the bundle. The running IMK waits for that receipt, then performs the full
    # activation convergence and retires the marker only after fresh readiness.
    exit 0
fi

echo "Hangyeol could not start in the current login session." >&2
/bin/launchctl bootout "gui/$USER_ID/$ACTIVATION_LABEL" \
    >/dev/null 2>&1 || true
if ! /bin/launchctl bootstrap "gui/$USER_ID" "$ACTIVATION_AGENT"; then
    echo "Hangyeol activation was deferred until the next login." >&2
    open_input_source_settings
fi

exit 0
