#!/bin/bash
# postinstall for PriType.pkg

APP_PATH="/Library/Input Methods/PriType.app"
APP_EXECUTABLE="$APP_PATH/Contents/MacOS/PriType"

CURRENT_USER=$(/usr/bin/stat -f "%Su" /dev/console 2>/dev/null || true)
case "$CURRENT_USER" in
    ""|root|loginwindow)
        exit 0
        ;;
esac

USER_ID=$(/usr/bin/id -u "$CURRENT_USER" 2>/dev/null || true)
if [ -z "$USER_ID" ]; then
    exit 0
fi

run_as_console_user() {
    /bin/launchctl asuser "$USER_ID" /usr/bin/sudo -H -u "$CURRENT_USER" "$@"
}

# Stop only PriType processes owned by the logged-in user. The executable may
# have been relaunched automatically while Installer replaced the bundle.
/usr/bin/pkill -x -u "$USER_ID" PriType 2>/dev/null || true
/usr/bin/pkill -x -u "$USER_ID" PriTypeV2 2>/dev/null || true

# Register and enable PriType synchronously in the logged-in user's TIS domain.
# The installer-only command selects PriType only when that user had no current
# PriType registration; updates preserve the user's selected input source.
run_as_console_user "$APP_EXECUTABLE" --post-install-prepare
PREPARE_STATUS=$?

# The first helper process can be the boundary that makes a freshly replaced
# TIS registration visible. Retry once without a timing delay; the helper keeps
# the preinstall selection snapshot until a fully ready attempt succeeds.
if [ "$PREPARE_STATUS" -ne 0 ]; then
    run_as_console_user "$APP_EXECUTABLE" --post-install-prepare
    PREPARE_STATUS=$?
fi

run_as_console_user /usr/bin/open "$APP_PATH" >/dev/null 2>&1 || true

if [ "$PREPARE_STATUS" -ne 0 ]; then
    run_as_console_user /usr/bin/open \
        "x-apple.systempreferences:com.apple.preference.keyboard?InputSources" \
        >/dev/null 2>&1 || true
fi

exit 0
