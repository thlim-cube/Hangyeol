#!/bin/bash
# postinstall for Hangyeol.pkg

APP_PATH="/Library/Input Methods/Hangyeol.app"
APP_EXECUTABLE="$APP_PATH/Contents/MacOS/Hangyeol"

CURRENT_USER=$(/usr/bin/stat -f "%Su" /dev/console 2>/dev/null || true)
case "$CURRENT_USER" in
    ""|root|loginwindow)
        exit 0
        ;;
esac

USER_ID=$(/usr/bin/id -u "$CURRENT_USER" 2>/dev/null || true)
if [ -z "$USER_ID" ]; then
    exit 0
fi

run_as_console_user() {
    /bin/launchctl asuser "$USER_ID" /usr/bin/sudo -H -u "$CURRENT_USER" "$@"
}

# Retired 2.x servers cannot own the current bundle's IMK connection. The
# current Hangyeol process is deliberately preserved: replacing its live
# client connections is a login-session boundary, not a safe installer action.
/usr/bin/pkill -x -u "$USER_ID" PriType 2>/dev/null || true
/usr/bin/pkill -x -u "$USER_ID" PriTypeV2 2>/dev/null || true

# Mark the settings presentation through a bounded helper command, then open
# the app while PackageKit still has the logged-in user's GUI context.
run_as_console_user "$APP_EXECUTABLE" --post-install-notify \
    >/dev/null 2>&1 || true
run_as_console_user /usr/bin/open "$APP_PATH" >/dev/null 2>&1 || true

# Input-source consent and TIS propagation are login-session work, not a
# PackageKit transaction. LaunchServices owns this independent signed helper,
# so Installer can finish while the helper waits for authoritative TIS state.
run_as_console_user /usr/bin/open -n -g "$APP_PATH" \
    --args --post-install-prepare >/dev/null 2>&1
PREPARE_LAUNCH_STATUS=$?

if [ "$PREPARE_LAUNCH_STATUS" -ne 0 ]; then
    run_as_console_user /usr/bin/open \
        "x-apple.systempreferences:com.apple.preference.keyboard?InputSources" \
        >/dev/null 2>&1 || true
fi

exit 0
